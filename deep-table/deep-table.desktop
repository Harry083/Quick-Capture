[Desktop Entry]
Type=Application
Name=Deep Table
Comment=Forensic SQLite viewer: deleted records, WAL history, BLOBs and timestamps
# Edit the path to where you unpacked the build.
Exec=/opt/DeepTable/DeepTable %f
Icon=/opt/DeepTable/deeptable.png
Terminal=false
MimeType=application/vnd.sqlite3;application/x-sqlite3;
Categories=Utility;Development;
